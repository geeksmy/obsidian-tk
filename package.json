{
  "name": "obsidian-tk",
  "version": "1.0.0",
  "description": "使用本地 LaTeX 工具链在 Obsidian 中渲染 TikZ 图表",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production"
  },
  "keywords": [
    "obsidian",
    "tikz",
    "latex",
    "pgfplots"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^16.11.6",
    "builtin-modules": "^3.2.0",
    "esbuild": "^0.28.0",
    "localforage": "^1.9.0",
    "obsidian": "latest",
    "typescript": "^5.9.3"
  }
}
