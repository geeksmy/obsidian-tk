{
  "compilerOptions": {
    "baseUrl": ".",
    "inlineSourceMap": true,
    "inlineSources": true,
    "module": "ESNext",
    "target": "ES6",
    "allowJs": false,
    "noImplicitAny": true,
    "moduleResolution": "node",
    "isolatedModules": true,
    "lib": ["DOM", "ES6", "ES7", "ES2021.String"]
  },
  "include": ["**/*.ts"]
}
